{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": ["**/*", ".storybook/**/*"],
  "exclude": [
    "node_modules",
    ".pnpm-store",
    ".cache",
    ".vitest",
    "storybook-static",
    "packages/ship-info/index.js",
    "packages/ship-info/index.js.map"
  ]
}
