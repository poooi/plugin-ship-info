{
  "name": "poi-plugins-workspace",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "description": "Monorepo workspace for poi plugins",
  "scripts": {
    "build": "pnpm -r run build",
    "build-storybook": "storybook build",
    "changelog:check": "node scripts/release/validate-changelog.mjs",
    "check": "tsc --noEmit",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "pack": "pnpm run pack:ship-info && pnpm run pack:navy-staff",
    "pack:ship-info": "pnpm --dir packages/ship-info pack --pack-destination ../../.cache/packages",
    "pack:navy-staff": "pnpm --dir packages/navy-staff pack --pack-destination ../../.cache/packages",
    "release:prepare": "node scripts/release/prepare.mjs",
    "release:validate": "node scripts/release/validate-release-pr.mjs",
    "storybook": "storybook dev -p 6006",
    "test": "vp test run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/poooi/plugin-ship-info.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@blueprintjs/core": "6.21.0",
    "@storybook/addon-vitest": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.19",
    "@testing-library/react": "^16.3.3",
    "@types/fs-extra": "11.0.4",
    "@types/lodash": "4.17.26",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/react-fontawesome": "^1.6.8",
    "@vitest/browser-playwright": "5.0.4",
    "classnames": "2.5.1",
    "fs-extra": "11.4.1",
    "fuse.js": "7.5.0",
    "i18next": "26.4.5",
    "jotai": "^3.0.1",
    "jsdom": "^30.1.2",
    "kcsapi": "1.260817.0",
    "lodash": "4.18.1",
    "modern-screenshot": "4.7.0",
    "playwright": "1.64.1",
    "polished": "4.3.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "17.0.16",
    "react-redux": "9.3.0",
    "redux": "5.0.1",
    "redux-thunk": "3.1.0",
    "reselect": "5.3.0",
    "storybook": "10.6.2",
    "styled-components": "6.6.0",
    "typescript": "7.0.2",
    "vite-plus": "^1.2.0",
    "vitest": "5.0.4",
    "wanakana": "5.3.1",
    "zod": "4.6.7"
  }
}
